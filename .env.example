# Copia este fichero a .env y rellénalo. NO subas el .env real.
# Genera claves con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto
INVITE_CODE=cambia-esto
# 1 si la app se sirve por HTTPS (detrás de un proxy); 0 solo para probar en local por http
COOKIE_SECURE=1

# Correo saliente para los avisos (opcional; sin esto, los avisos no se envían)
#SMTP_HOST=smtp.ejemplo.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Suscripciones <avisos@ejemplo.com>
